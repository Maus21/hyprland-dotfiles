#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

status=0
if rg -n --hidden --glob '!.git/**' --glob '!scripts/secret-scan' \
  '/home/lorenzo|BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY|gh[pousr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]+|"tlpSudoPassword"[[:space:]]*:[[:space:]]*"[^"[:space:]]+"|([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}'; then
  status=1
fi

if find . -type f -not -path './.git/*' \
  \( -iname 'Cookies' -o -iname 'Login Data' -o -iname 'History' -o -iname 'Local State' -o -iname '*.pem' -o -iname '*.key' \) \
  -print | rg .; then
  status=1
fi

if find . -type f -size +95M -not -path './.git/*' -print | while read -r file; do
  if ! git check-attr filter -- "$file" | rg -q ': lfs$'; then
    printf 'Oversized non-LFS file: %s\n' "$file"
  fi
done | rg .; then
  status=1
fi

exit "$status"
