#!/usr/bin/env bash
set -euo pipefail

target_home="${DOTFILES_TARGET_HOME:-$HOME}"
output="$target_home/.config/hypr/hardware.lua"

for command_name in hyprctl jq; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    printf 'Missing required command: %s\n' "$command_name" >&2
    exit 1
  fi
done

monitors="$(hyprctl monitors -j)"
count="$(jq 'length' <<<"$monitors")"
if [ "$count" -lt 1 ]; then
  printf 'Hyprland did not report any monitors. Run this inside a Hyprland session.\n' >&2
  exit 1
fi

primary="$(jq -r '[.[] | select(.name | test("^(eDP|LVDS|DSI)-") | not)][0].name // ([.[] | select(.focused)][0].name) // .[0].name' <<<"$monitors")"
secondary="$(jq -r --arg primary "$primary" '[.[] | select(.name != $primary)][0].name // empty' <<<"$monitors")"

valid_output='^[A-Za-z0-9_.:-]+$'
if [[ ! "$primary" =~ $valid_output ]] || { [ -n "$secondary" ] && [[ ! "$secondary" =~ $valid_output ]]; }; then
  printf 'Refusing unexpected monitor name returned by Hyprland.\n' >&2
  exit 1
fi

render_monitor() {
  local name="$1"
  local mode scale
  mode="$(jq -r --arg name "$name" '.[] | select(.name == $name) | "\(.width)x\(.height)@\(.refreshRate)"' <<<"$monitors")"
  scale="$(jq -r --arg name "$name" '.[] | select(.name == $name) | .scale' <<<"$monitors")"
  printf 'hl.monitor({ output = "%s", mode = "%s", position = "auto", scale = "%s", vrr = 2 })\n' "$name" "$mode" "$scale"
}

mkdir -p "$(dirname "$output")"
tmp="$(mktemp "${output}.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
{
  printf '%s\n' '-- Generated by scripts/configure-displays; intentionally not tracked.'
  render_monitor "$primary"
  if [ -n "$secondary" ]; then
    render_monitor "$secondary"
  fi
  printf '\n'
  printf 'hl.on("hyprland.start", function()\n'
  printf '\thl.exec_cmd("xrandr --output %s --primary")\n' "$primary"
  printf 'end)\n'
  printf '\n'
  for workspace in 1 2 3 4 5; do
    printf 'hl.workspace_rule({ workspace = "%s", monitor = "%s", persistent = true })\n' "$workspace" "$primary"
  done
  if [ -n "$secondary" ]; then
    for workspace in 6 7 8 9 10; do
      printf 'hl.workspace_rule({ workspace = "%s", monitor = "%s", persistent = true })\n' "$workspace" "$secondary"
    done
  else
    for workspace in 6 7 8 9 10; do
      printf 'hl.workspace_rule({ workspace = "%s", monitor = "%s", persistent = true })\n' "$workspace" "$primary"
    done
  fi
} >"$tmp"
mv "$tmp" "$output"
trap - EXIT

printf 'Wrote %s (primary: %s%s)\n' "$output" "$primary" "${secondary:+, secondary: $secondary}"
hyprctl reload >/dev/null
