#!/usr/bin/env bash
set -euo pipefail

desktop_file="${1:-}"
[ -f "$desktop_file" ] || exit 2

desktop_id="$(basename "$desktop_file" .desktop)"

entry_value() {
  local key="$1"
  awk -F= -v key="$key" '
    $0 == "[Desktop Entry]" { in_entry = 1; next }
    /^\[/ && $0 != "[Desktop Entry]" { in_entry = 0 }
    in_entry && $1 == key {
      sub(/^[^=]*=/, "")
      print
      exit
    }
  ' "$desktop_file"
}

terminal="$(entry_value Terminal | tr '[:upper:]' '[:lower:]')"
exec_line="$(entry_value Exec)"
prefers_non_default_gpu="$(entry_value PrefersNonDefaultGPU | tr '[:upper:]' '[:lower:]')"
x_kde_discrete_gpu="$(entry_value X-KDE-RunOnDiscreteGpu | tr '[:upper:]' '[:lower:]')"

launch_prefix=()
if [ "$prefers_non_default_gpu" = "true" ] || [ "$x_kde_discrete_gpu" = "true" ]; then
  if command -v switcherooctl >/dev/null 2>&1 \
      && switcherooctl list 2>/dev/null | grep -q '^Device:'; then
    launch_prefix=(switcherooctl launch)
  elif command -v prime-run >/dev/null 2>&1; then
    launch_prefix=(prime-run)
  fi
fi

strip_field_codes() {
  printf '%s\n' "$1" | sed -E 's/[[:space:]]+%[fFuUdDnNickvm]//g; s/%[fFuUdDnNickvm]//g; s/[[:space:]]+$//'
}

if [ "$terminal" = "true" ]; then
  command_line="$(strip_field_codes "$exec_line")"
  [ -n "$command_line" ] || exit 3
  setsid kitty -e "${launch_prefix[@]}" sh -lc "exec $command_line" >/dev/null 2>&1 &
  exit 0
fi

if command -v gtk-launch >/dev/null 2>&1; then
  setsid "${launch_prefix[@]}" gtk-launch "$desktop_id" >/dev/null 2>&1 && exit 0
fi

setsid "${launch_prefix[@]}" gio launch "$desktop_file" >/dev/null 2>&1 && exit 0

command_line="$(strip_field_codes "$exec_line")"
[ -n "$command_line" ] || exit 3
setsid "${launch_prefix[@]}" sh -lc "exec $command_line" >/dev/null 2>&1 &
exit 0
