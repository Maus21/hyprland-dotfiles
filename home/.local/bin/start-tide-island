#!/usr/bin/env bash
set -euo pipefail

pkill -x waybar >/dev/null 2>&1 || true
systemctl --user stop swaync.service >/dev/null 2>&1 || true
pkill -x swaync >/dev/null 2>&1 || true
pkill -x swaync-client >/dev/null 2>&1 || true
logfile="$HOME/.cache/tide-island-dotfiles.log"
local_qml="$HOME/.local/share/tide-island-dotfiles"

if ! command -v tide-island >/dev/null 2>&1; then
  printf 'Tide Island is not installed. Run the repository installer without --skip-packages.\n' >&2
  exit 127
fi

systemctl --user import-environment HYPRLAND_INSTANCE_SIGNATURE WAYLAND_DISPLAY >/dev/null 2>&1 || true

service_pid="$(systemctl --user show --property=MainPID --value tide-island-dotfiles.service 2>/dev/null || true)"
service_signature=""
if [[ "$service_pid" =~ ^[0-9]+$ ]] && (( service_pid > 0 )) && [[ -r "/proc/$service_pid/environ" ]]; then
  service_signature="$(tr '\0' '\n' < "/proc/$service_pid/environ" | sed -n 's/^HYPRLAND_INSTANCE_SIGNATURE=//p')"
fi

if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] \
  && [[ -n "$service_pid" ]] \
  && [[ "$service_pid" != "0" ]] \
  && [[ "$service_signature" != "$HYPRLAND_INSTANCE_SIGNATURE" ]]; then
  systemctl --user restart tide-island-dotfiles.service
  exit 0
fi

if command -v quickshell >/dev/null 2>&1 \
  && quickshell ipc --any-display -p "$local_qml" call island show >/dev/null 2>&1; then
  exit 0
fi

systemctl --user stop tide-island.service >/dev/null 2>&1 || true
systemctl --user stop tide-island-lorenzo.service >/dev/null 2>&1 || true
quickshell kill --any-display -p /usr/share/tide-island >/dev/null 2>&1 || true
systemctl --user daemon-reload
systemctl --user enable --now tide-island-dotfiles.service >/dev/null
